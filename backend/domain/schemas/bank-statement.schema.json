{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Bank Statement Schema",
  "properties": {
    "bank_name": {
      "type": "string",
      "description": "Name of the bank or financial institution"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Full name of the account holder"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number (last 4 digits if masked)",
      "pattern": "^[\\d\\*]+$"
    },
    "statement_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start date of statement period (YYYY-MM-DD)"
    },
    "statement_period_end": {
      "type": "string",
      "format": "date",
      "description": "End date of statement period (YYYY-MM-DD)"
    },
    "beginning_balance": {
      "type": "number",
      "description": "Account balance at start of period"
    },
    "ending_balance": {
      "type": "number",
      "description": "Account balance at end of period"
    },
    "total_deposits": {
      "type": "number",
      "description": "Total deposits during the period"
    },
    "total_withdrawals": {
      "type": "number",
      "description": "Total withdrawals during the period"
    }
  },
  "required": [
    "bank_name",
    "account_holder_name",
    "account_number",
    "statement_period_start",
    "statement_period_end",
    "ending_balance"
  ]
}
